			fi
		else
			echo "  (暂无 Sing-Box 日志)"
		fi

		echo ""
		# 2. DNS 异常与耗时监控
		echo "🌐【3. DNS 异常与慢解析诊断 (Slow / NXDOMAIN)】"
		if [ -n "$log_files" ]; then
			local doh_errs="$(grep -E 'dns: exchange failed.*(EOF|timeout|refused)' $log_files 2>/dev/null | head -n 3)"
			if [ -n "$doh_errs" ]; then

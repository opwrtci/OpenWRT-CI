			;;
		2)
			printf "请输入全新的 GitHub Token: "
			read -r new_gh_tok
			[ -n "$new_gh_tok" ] && save_credentials "$GEMINI_API_KEY" "$new_gh_tok" "$GEMINI_MODEL" && echo "✅ GitHub Token 已更新！"
			;;
		3)
			printf "请输入模型名称 (默认: gemini-3.5-flash-lite): "
			read -r new_mod
			[ -n "$new_mod" ] && save_credentials "$GEMINI_API_KEY" "$GITHUB_TOKEN" "$new_mod" && echo "✅ 模型已更新为: $new_mod"
			;;
		4)
			rm -f "$CRED_FILE" 2>/dev/null
			export GEMINI_API_KEY=""

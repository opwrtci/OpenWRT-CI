			}
			function format_dev(ip) {
				if (ip in hosts) return ip " (" hosts[ip] ")";
				return ip;
			}
			/inbound\/tun.*inbound redirect connection from/ {
				id = substr($5, 2);
				for(i=1;i<=NF;i++) if ($i == "from") { src = $(i+1); sub(/:[0-9]+$/, "", src); conn_src[id] = format_dev(src); }
			}
			/router: (sniffed protocol: .*, domain:|found reserve mapped domain:)/ {
				id = substr($5, 2);
				for(i=1;i<=NF;i++) {

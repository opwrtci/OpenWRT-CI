do_config() {
	load_credentials
	echo "============================================================"
	echo "         🔐 CapCtl 本地私有安全凭据管理 (Config)            "
	echo "============================================================"
	echo "📁 配置文件路径 : $CRED_FILE (权限 600)"
	local mask_gemini="未配置 (未设置)"
	if [ -n "$GEMINI_API_KEY" ]; then
		mask_gemini="$(echo "$GEMINI_API_KEY" | awk '{if(length($0)>12) print substr($0,1,8) "****************" substr($0,length($0)-3); else print "已配置(已隐藏)"}')"

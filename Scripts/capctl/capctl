get_curl_proxy_opt() {
	if netstat -tulnp 2>/dev/null | grep -q ':5330[[:space:]]'; then
		echo "--proxy http://127.0.0.1:5330"
	elif [ -n "$http_proxy" ]; then
		echo "--proxy $http_proxy"
	fi
}

github_api_append_domain() {
	local dom="$1"
	local file_path="$2"
	local repo="opwrtci/meta-rules-dat"

	[ -z "$GITHUB_TOKEN" ] && return 1

	local proxy_opt="$(get_curl_proxy_opt)"
	local api_url="https://api.github.com/repos/$repo/contents/$file_path"
	local get_resp="$(curl -s -m 15 $proxy_opt -H "Authorization: Bearer $GITHUB_TOKEN" \
		-H "Accept: application/vnd.github+json" \
		-H "X-GitHub-Api-Version: 2022-11-28" \
		"$api_url")"

	local sha="$(echo "$get_resp" | grep -o -E '"sha"[[:space:]]*:[[:space:]]*"[^"]+"' | head -n 1 | cut -d'"' -f4)"
	if [ -z "$sha" ]; then
		echo "⚠️  [GitHub API] 无法获取 $file_path 的 SHA 信息"
		return 1
	fi

	local b64="$(echo "$get_resp" | grep -o -E '"content"[[:space:]]*:[[:space:]]*"[^"]+"' | head -n 1 | cut -d'"' -f4)"
	local raw_content="$(echo "$b64" | sed 's/\\n//g' | base64 -d 2>/dev/null)"

	if echo "$raw_content" | grep -Fxq "$dom"; then
		echo "ℹ️  [GitHub API] $file_path 中已收录 $dom，无需重复提交。"
		return 0
	fi

	local updated_content="${raw_content}
${dom}"
	local updated_b64="$(echo "$updated_content" | base64 | tr -d '\n')"

	local payload="{\"message\":\"feat(rules): sync domestic domain $dom via capctl AI\",\"content\":\"$updated_b64\",\"sha\":\"$sha\",\"branch\":\"master\"}"

	local put_resp="$(curl -s -m 15 $proxy_opt -X PUT "$api_url" \
		-H "Authorization: Bearer $GITHUB_TOKEN" \
		-H "Accept: application/vnd.github+json" \
		-H "X-GitHub-Api-Version: 2022-11-28" \
		-d "$payload")"

	if echo "$put_resp" | grep -q '"commit"'; then
		echo "✅ [GitHub API] 成功提交 $dom 至 $file_path"
		return 0
	else
		local err_msg="$(echo "$put_resp" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
		echo "⚠️  [GitHub API] 提交失败: ${err_msg:-未知错误}"
		return 1
	fi
}

sync_to_github_repo() {
	local dom="$1"
	local git_repo="/home/joefom/Public/gitpro/meta-rules-dat"

	if [ -d "$git_repo/.git" ]; then
		echo "------------------------------------------------------------"
		echo "🔍 [远程联动] 检测到本地 meta-rules-dat Git 仓库，准备自动同步..."
		local c_domains="$git_repo/custom-rules/china-custom-domains.txt"
		local r_direct="$git_repo/resouces/direct.txt"
		local changed=0

		if [ -f "$c_domains" ] && ! grep -Fxq "$dom" "$c_domains"; then
			echo "$dom" >> "$c_domains"
			changed=1
		fi
		if [ -f "$r_direct" ] && ! grep -Fxq "$dom" "$r_direct"; then
			echo "$dom" >> "$r_direct"
			changed=1
		fi

		if [ $changed -eq 1 ]; then
			(
				cd "$git_repo" || exit 1
				git add custom-rules/china-custom-domains.txt resouces/direct.txt
				git commit -m "feat(rules): sync domestic domain $dom via capctl"
				git push origin master >/dev/null 2>&1
			)
			echo "🎉 [远程同步] 本地 Git 仓库已提交并推送到 GitHub master！"
		else
			echo "ℹ️  [远程检查] 本地 Git 仓库规则文件中已包含 $dom。"
		fi
	elif [ -n "$GITHUB_TOKEN" ]; then
		echo "------------------------------------------------------------"
		echo "🐙 [远程联动] 通过 GitHub REST API 同步至 opwrtci/meta-rules-dat..."
		github_api_append_domain "$dom" "custom-rules/china-custom-domains.txt"
		github_api_append_domain "$dom" "resouces/direct.txt"
		echo "🎉 [远程同步] GitHub REST API 同步完成！云端规则编译将自动触发。"
	else
		echo "ℹ️  [远程联动] 未检测到本地 Git 仓库或 GITHUB_TOKEN，跳过远程提交 (运行 capctl config 可随时配置 Token)。"
	fi
}

do_add_direct() {
	local dom="$1"
	if [ -z "$dom" ]; then
		echo "用法: capctl add-direct <域名>"
		echo "示例: capctl add-direct ctobsnssdk.com"
		return 1
	fi

	dom="$(echo "$dom" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

	echo "============================================================"
	echo "   🚀 CapCtl 一键直连入库与多端联动 (Add Direct Rule)        "
	echo "============================================================"
	echo "目标域名: $dom"
	echo "------------------------------------------------------------"

	# 第一步：本地秒级生效
	local direct_file="/etc/homeproxy/diversion/direct.txt"
	if [ -f "$direct_file" ]; then
		if grep -Fxq "$dom" "$direct_file"; then
			echo "ℹ️  [本地检查] 域名 $dom 已存在于本地直连列表 ($direct_file)，无需重复追加。"
		else
			echo "$dom" >> "$direct_file"
			echo "✅ [本地写入] 成功追加 $dom 至 $direct_file"
			echo "⏳ [本地重载] 正在重载 HomeProxy 生效规则..."
			/etc/init.d/homeproxy reload >/dev/null 2>&1
			echo "🎉 [第一步完成] 本地秒级生效已完成！$dom 已加入直连并由 Sing-Box 内核即刻执行。"
		fi
	else
		echo "⚠️ 未找到 HomeProxy 本地直连文件 ($direct_file)，跳过本地写入。"
	fi

	# 第二步：联动远程 Git 仓库 / GitHub REST API
	sync_to_github_repo "$dom"
	echo "============================================================"
}

do_ai_audit() {
	local auto_sync=0
	local force_run=0

	for arg in "$@"; do
		case "$arg" in
			sync|auto) auto_sync=1 ;;
			--force|-f|force) force_run=1 ;;
		esac
	done

	ensure_gemini_key || return 1

	local target_mnt="$(get_largest_mount)"
	local base_dir="$target_mnt/pcap_vault"
	local pool_file="$base_dir/candidate_pool.json"
	local last_ai_file="$base_dir/.last_ai_audit_ts"
	local min_interval=172800 # 2 天 (48 小时 = 172800 秒)

	# 1. 频次安全熔断 (原则: 先慢慢收集规则，等规则收集的差不多了再让 Gemini 判断，触发频率不得低于 2 天)
	local now_epoch="$(date +%s)"
	local last_ai_epoch=0
	[ -f "$last_ai_file" ] && last_ai_epoch="$(cat "$last_ai_file" 2>/dev/null || echo 0)"
	local elapsed=$((now_epoch - last_ai_epoch))

	if [ "$last_ai_epoch" -gt 0 ] && [ "$elapsed" -lt "$min_interval" ]; then
		local remaining_secs=$((min_interval - elapsed))
		local rem_hours=$((remaining_secs / 3600))
		local rem_mins=$(( (remaining_secs % 3600) / 60 ))
		local past_hours=$((elapsed / 3600))
		local past_mins=$(( (elapsed % 3600) / 60 ))

		if [ "$force_run" -eq 0 ]; then
			if [ -t 0 ]; then
				echo "============================================================"
				echo "      ⏳ CapCtl AI 规则沉淀冷却保护 (48小时防频控保护)       "
				echo "============================================================"
				echo "⏰ 上次研判时间 : $(cat "$base_dir/.last_ai_audit_human" 2>/dev/null || echo "近期") (已过去 ${past_hours}小时 ${past_mins}分)"
				echo "🛡️  最小沉淀周期 : 48 小时 (不得低于 2 天，确保充分收集真实流量与样本)"
				echo "⏳ 距离推荐研判 : 尚需沉淀 ${rem_hours}小时 ${rem_mins}分"
				echo "------------------------------------------------------------"
				if [ "$auto_sync" -eq 1 ]; then
					printf "⚠️  是否跳过沉淀冷却期，强制立即触发 Gemini 研判并自动入库同步? [y/N]: "
				else
					printf "⚠️  是否为了紧急排障跳过沉淀冷却期，强制立即调用 Gemini 深度研判? [y/N]: "
				fi
				read -r override_choice
				if [ "$override_choice" != "y" ] && [ "$override_choice" != "Y" ]; then
					echo "ℹ️  已保持沉淀状态。capctl 将在后台持续累积多天流量样本与设备特征。"
					return 0
				fi
			else
				echo "⏳ [AI 频控保护] 距离上次研判仅 ${past_hours}小时 (冷却期: 48小时/2天)，跳过本次调用以持续沉淀样本。"
				if [ "$auto_sync" -eq 1 ]; then
					echo "💡 如需立即强制分析与同步，可附加参数: capctl ai-sync --force"
				else
					echo "💡 如需立即强制分析，可附加参数: capctl ai --force"
				fi
				return 0
			fi
		else
			echo "⚡ 检测到强制参数，跳过 48 小时沉淀冷却期直接运行..."
		fi
	fi

	# 2. 定位或同步最新候选数据 (自动刷新长效候选池)
	echo "🔍 正在从抓包记录与分流日志中增量提炼最新候选域名..."
	do_extract silent >/dev/null 2>&1

	local source_file="$pool_file"
	if [ ! -f "$source_file" ] || [ ! -s "$source_file" ]; then
		source_file="$(find "$base_dir" -maxdepth 2 -name 'candidate_rules_latest.json' 2>/dev/null | sort | tail -n 1)"
	fi

	if [ ! -f "$source_file" ] || [ ! -s "$source_file" ]; then
		echo "❌ 未能找到有效的规则候选数据，请先运行 capctl start 抓包一段时间收集流量。"
		return 1
	fi

	local cand_count="$(grep -o '"domain":' "$source_file" 2>/dev/null | wc -l)"
	if [ "$cand_count" -eq 0 ]; then
		echo "============================================================"
		echo "      🤖 CapCtl AI 智能审计 (Gemini 3.5 Flash Lite)        "
		echo "============================================================"
		echo "✅ 当前长效候选池为空，暂无新发现的国内漏网域名！"
		echo "============================================================"
		return 0
	fi

	echo "============================================================"
	echo "      🤖 CapCtl AI 深度架构研判 (Gemini 3.5 Flash Lite)    "
	echo "============================================================"
	echo "📊 累积候选域名 : $cand_count 个 (已跨天聚合样本与频次)"
	echo "🤖 调用推理模型 : ${GEMINI_MODEL:-gemini-3.5-flash-lite}"
	echo "🧠 研判安全准则 : 零误判原则 (Deep Chain-of-Thought / 高 Token 深度推理)"
	echo "⏳ 正在提交大模型进行商业主体、CNAME 拓扑、跨国风险与冗余性深度审查..."
	echo "------------------------------------------------------------"

	local req_file="/tmp/capctl_gemini_req.json"
	local resp_file="/tmp/capctl_gemini_resp.json"

	awk '
	BEGIN {
		printf "{\"contents\":[{\"parts\":[{\"text\":\"You are a Principal Network Architect and DNS/BGP Infrastructure Specialist for Chinese Internet, Sing-Box routing, and CDN edge topology. Your core objective is ABSOLUTE ZERO FALSE POSITIVES. It is far better to mark SKIP or KEEP_PROXY than to mistakenly whitelist an overseas or foreign-dependent service.\\n\\nCandidate domains collected from router live traffic:\\n"
	}
	{
		line = $0;
		gsub(/\\/, "\\\\\\\\", line);
		gsub(/"/, "\\\\\"", line);
		gsub(/\r/, "", line);
		printf "%s ", line;
	}
	END {
		printf "\\n\\nTo guarantee extreme accuracy, perform a comprehensive deep-dive Chain-of-Thought analysis for each candidate domain before reaching a conclusion:\\n1. Corporate Ownership & Service Purpose: Identify true parent company (e.g. Alibaba, Tencent, ByteDance, Sina, Baidu, Meituan) and business function.\\n2. Network Architecture & CNAME Topology: Analyze CDN CNAME pointers and domestic datacenter hosting.\\n3. Overseas & Cross-Border Risk Assessment: Is this domain dual-homed, Anycast, international ad attribution (e.g. Appier, Adjust), or Google/Apple telemetry?\\n4. Redundancy Check: Is it a common top-level root domain (e.g. aliyun.com, qq.com, baidu.com) already globally covered by upstream geosite:cn rulesets?\\n5. Final Verdict:\\n   - ADD_DIRECT: Pure Mainland China domestic cloud/app/SDK infrastructure. Whitelisting it avoids proxy lag and is 100%% safe. Confidence >= 92.\\n   - SKIP_INCLUDED: Common root domain already covered upstream. Adding is redundant.\\n   - KEEP_PROXY: International, foreign CDN, ad attribution, or cross-border tool that must remain proxied.\\n   - UNCERTAIN: Ambiguous or uncertain ownership.\\n\\nSpend adequate tokens to thoroughly reason and explain. Respond ONLY in valid JSON matching this schema:\\n{\\\"results\\\":[{\\\"domain\\\":\\\"example.com\\\",\\\"decision\\\":\\\"ADD_DIRECT|SKIP_INCLUDED|KEEP_PROXY|UNCERTAIN\\\",\\\"confidence\\\":95,\\\"company\\\":\\\"Company Name\\\",\\\"rationale\\\":\\\"Comprehensive detailed technical reason\\\"}]}\"}]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":8192,\"responseMimeType\":\"application/json\"}}\n"
	}
	' "$source_file" > "$req_file"

	local model="${GEMINI_MODEL:-gemini-3.5-flash-lite}"
	model="${model#\"}"; model="${model%\"}"; model="${model#\'}"; model="${model%\'}"
	local api_key="${GEMINI_API_KEY#\"}"; api_key="${api_key%\"}"; api_key="${api_key#\'}"; api_key="${api_key%\'}"
	local api_url="https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${api_key}"

	local proxy_opt="$(get_curl_proxy_opt)"
	curl -s -m 45 $proxy_opt -X POST "$api_url" \
		-H "Content-Type: application/json" \
		-d @"$req_file" > "$resp_file"

	rm -f "$req_file"

	# 模型不可用时的回退机制
	if grep -q '"error"' "$resp_file" && grep -q 'NOT_FOUND' "$resp_file"; then
		if [ "$model" != "gemini-2.5-flash" ]; then
			echo "🔄 检测到模型 $model 不可用，平滑切换至 gemini-2.5-flash 重试..."
			model="gemini-2.5-flash"
			api_url="https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${api_key}"
			awk '
			BEGIN {
				printf "{\"contents\":[{\"parts\":[{\"text\":\"You are a Principal Network Architect and DNS/BGP Infrastructure Specialist for Chinese Internet. Evaluate these candidate domains with zero false positives. Respond ONLY with valid JSON schema: {\\\"results\\\":[{\\\"domain\\\":\\\"example.com\\\",\\\"decision\\\":\\\"ADD_DIRECT|SKIP_INCLUDED|KEEP_PROXY|UNCERTAIN\\\",\\\"confidence\\\":95,\\\"company\\\":\\\"Company Name\\\",\\\"rationale\\\":\\\"Detailed rationale\\\"}]}. Candidates:\\n"
			}
			{
				line = $0; gsub(/\\/, "\\\\\\\\", line); gsub(/"/, "\\\\\"", line); gsub(/\r/, "", line); printf "%s ", line;
			}
			END {
				printf "\"}]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":8192,\"responseMimeType\":\"application/json\"}}\n"
			}
			' "$source_file" > "$req_file"

			curl -s -m 45 $proxy_opt -X POST "$api_url" \
				-H "Content-Type: application/json" \
				-d @"$req_file" > "$resp_file"
			rm -f "$req_file"
		fi
	fi

	# 检查报错
	if grep -q '"error"' "$resp_file" 2>/dev/null; then
		local err_msg="$(grep -o -E '"message"[[:space:]]*:[[:space:]]*"[^"]+"' "$resp_file" | head -n 1 | cut -d'"' -f4)"
		echo "❌ Gemini API 调用失败: ${err_msg:-请检查 API Key 或网络连通性}"
		rm -f "$resp_file"
		return 1
	fi

	if ! grep -q '"candidates"' "$resp_file" 2>/dev/null; then
		echo "❌ Gemini API 返回异常，原始响应:"
		head -n 5 "$resp_file"
		rm -f "$resp_file"
		return 1
	fi

	# 解析模型研判结果
	local parsed_results="$(sed -e 's/\\"/"/g' -e 's/\\n/\n/g' "$resp_file" | awk -v RS="}" '
	{
		dom=""; dec=""; conf=0; comp=""; rat="";
		if (match($0, /"domain"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); dom = s;
		}
		if (match($0, /"decision"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); dec = s;
		}
		if (match($0, /"confidence"[[:space:]]*:[[:space:]]*[0-9]+/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*/, "", s); conf = s;
		}
		if (match($0, /"company"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); comp = s;
		}
		if (match($0, /"rationale"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); rat = s;
		}
		if (dom != "" && dec != "") {
			print dom "|" dec "|" conf "|" comp "|" rat;
		}
	}
	')"

	rm -f "$resp_file"

	if [ -z "$parsed_results" ]; then
		echo "⚠️  未能从大模型响应中解析出结构化研判数据。"
		return 1
	fi

	# 更新最近研判时间戳
	date +%s > "$last_ai_file"
	date "+%Y-%m-%d %H:%M:%S" > "$base_dir/.last_ai_audit_human"

	# 初始化细粒度审计日志 (定位分析准与不准的原因)
	local ai_log_file="/var/log/capctl_ai.log"
	local ai_vault_log="$base_dir/ai_audit.log"
	rotate_ai_log "$ai_log_file"
	rotate_ai_log "$ai_vault_log"

	local session_ts="$(date '+%Y-%m-%d %H:%M:%S')"
	local ai_mode_tag="MANUAL"
	[ "$force_run" -eq 1 ] && ai_mode_tag="MANUAL_FORCE"
	[ "$auto_sync" -eq 1 ] && ai_mode_tag="${ai_mode_tag}+AUTOSYNC"

	{
		echo "================================================================================"
		echo "[$session_ts] 🤖 CapCtl AI 规则研判会话启动 [$ai_mode_tag]"
		echo "⚙️  模型: $model | 候选域名数: $cand_count 个 | 规则库: $source_file"
		echo "--------------------------------------------------------------------------------"
	} >> "$ai_log_file" 2>/dev/null || true
	[ -d "$base_dir" ] && {
		echo "================================================================================"
		echo "[$session_ts] 🤖 CapCtl AI 规则研判会话启动 [$ai_mode_tag]"
		echo "⚙️  模型: $model | 候选域名数: $cand_count 个 | 规则库: $source_file"
		echo "--------------------------------------------------------------------------------"
	} >> "$ai_vault_log" 2>/dev/null || true

	echo "📋 Gemini 3.5 Flash Lite 深度架构研判结果:"
	echo "------------------------------------------------------------"

	local approved_domains=""
	local direct_count=0
	local skip_count=0
	local proxy_count=0

	local old_ifs="$IFS"
	IFS='
'
	for item in $parsed_results; do
		local f_dom="$(echo "$item" | cut -d'|' -f1 | sed 's/^"//;s/"$//')"
		local f_dec="$(echo "$item" | cut -d'|' -f2 | sed 's/^"//;s/"$//')"
		local f_conf="$(echo "$item" | cut -d'|' -f3 | tr -dc '0-9')"
		local f_comp="$(echo "$item" | cut -d'|' -f4 | sed 's/^"//;s/"$//')"
		local f_rat="$(echo "$item" | cut -d'|' -f5 | sed 's/^"//;s/"$//')"

		# 提取该域名在候选池中的抓包证据
		local ev_hits="$(awk -v dom="$f_dom" 'BEGIN{RS="}";FS=","} $0 ~ "\"domain\":\"" dom "\"" {for(i=1;i<=NF;i++){if($i~/\"hits\":/){sub(/.*\"hits\":/,"",$i);gsub(/[^0-9]/,"",$i);print $i;exit}}}' "$source_file" 2>/dev/null)"
		local ev_sample="$(awk -v dom="$f_dom" 'BEGIN{RS="}";FS=","} $0 ~ "\"domain\":\"" dom "\"" {for(i=1;i<=NF;i++){if($i~/\"samples\":/){sub(/.*\"samples\":\"?/,"",$i);sub(/\"$/,"",$i);print $i;exit}}}' "$source_file" 2>/dev/null)"
		local ev_reason="$(awk -v dom="$f_dom" 'BEGIN{RS="}";FS=","} $0 ~ "\"domain\":\"" dom "\"" {for(i=1;i<=NF;i++){if($i~/\"reason\":/){sub(/.*\"reason\":\"?/,"",$i);sub(/\"$/,"",$i);print $i;exit}}}' "$source_file" 2>/dev/null)"
		[ -z "$ev_hits" ] && ev_hits="1"

		local action_log=""
		case "$f_dec" in
			ADD_DIRECT)
				echo "  🟢 [建议直连] $f_dom (置信度: ${f_conf}%)"
				echo "     • 所属主体: $f_comp"
				echo "     • 流量线索: 累计命中 ${ev_hits} 次${ev_sample:+ | 样本: $ev_sample}${ev_reason:+ | 归因: $ev_reason}"
				echo "     • 深度研判: $f_rat"
				if [ "$f_conf" -ge 90 ] 2>/dev/null; then
					approved_domains="${approved_domains} $f_dom"
					direct_count=$((direct_count + 1))
					action_log="QUALIFIED (置信度达标 >=90%，列入直连候选)"
				else
					action_log="CONFIDENCE_LOW (置信度未达90%，暂缓入库)"
				fi
				;;
			SKIP_INCLUDED)
				echo "  🟡 [无需添加] $f_dom (置信度: ${f_conf}%)"
				echo "     • 所属主体: $f_comp"
				echo "     • 深度研判: $f_rat (上游基础规则库已收录)"
				skip_count=$((skip_count + 1))
				action_log="PRUNED (上游已收录，从候选池修剪)"
				prune_from_candidate_pool "$f_dom"
				;;
			KEEP_PROXY)
				echo "  🔴 [保持代理] $f_dom (置信度: ${f_conf}%)"
				echo "     • 所属主体: $f_comp"
				echo "     • 深度研判: $f_rat"
				proxy_count=$((proxy_count + 1))
				action_log="KEPT_PROXY (境外/第三方依赖，保持代理)"
				;;
			*)
				echo "  ⚪ [存疑待定] $f_dom"
				echo "     • 深度研判: $f_rat"
				action_log="UNCERTAIN (信息不足，继续沉淀样本)"
				;;
		esac

		# 写入细粒度审计日志供定位准/不准原因
		local detail_log="[研判记录] 域名: $f_dom | 决议: $f_dec (${f_conf}%)
  • 主体识别: $f_comp
  • 流量线索: 命中 ${ev_hits} 次${ev_sample:+ | 样本: $ev_sample}${ev_reason:+ | 特征: $ev_reason}
  • 决策推导: $f_rat
  • 状态动作: $action_log"

		echo "$detail_log" >> "$ai_log_file" 2>/dev/null || true
		[ -d "$base_dir" ] && echo "$detail_log" >> "$ai_vault_log" 2>/dev/null || true
		echo ""
	done
	IFS="$old_ifs"

	echo "------------------------------------------------------------"
	echo "📊 研判汇总: 建议直连 $direct_count 个 | 建议忽略 $skip_count 个 | 保持代理 $proxy_count 个"

	local summary_log="[会话总结] 建议直连: $direct_count 个 | 规则冗余: $skip_count 个 | 保持代理: $proxy_count 个
================================================================================"
	echo "$summary_log" >> "$ai_log_file" 2>/dev/null || true
	[ -d "$base_dir" ] && echo "$summary_log" >> "$ai_vault_log" 2>/dev/null || true

	if [ $auto_sync -eq 1 ]; then
		if [ -n "$approved_domains" ]; then
			echo "============================================================"
			echo "   ⚡ 正在自动将高置信度域名执行本地热生效与远程同步...      "
			echo "============================================================"
			for adom in $approved_domains; do
				do_add_direct "$adom"
				prune_from_candidate_pool "$adom"
				echo "[[$session_ts] 自动生效同步] 域名 $adom 已写入 direct.txt 并同步远程" >> "$ai_log_file" 2>/dev/null || true
				[ -d "$base_dir" ] && echo "[[$session_ts] 自动生效同步] 域名 $adom 已写入 direct.txt 并同步远程" >> "$ai_vault_log" 2>/dev/null || true
			done
		else
			echo "ℹ️  当前没有达到置信阈值 (>=90%) 的待入库域名，无需执行同步。"
		fi
	else
		if [ -n "$approved_domains" ]; then
			echo "💡 提示: 运行 capctl ai-sync 可一键将上述高置信度域名自动应用生效。"
		fi
	fi
	echo "============================================================"
}


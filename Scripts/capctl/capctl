			}
			/connection: connection (download|upload) finished/ {
				id = substr($5, 2);
				dur_str = substr($6, 1, length($6)-1);
				sec = 0;
				if (dur_str ~ /ms$/) {
					sub(/ms$/, "", dur_str);
					sec = (dur_str + 0) / 1000.0;
				} else if (dur_str ~ /s$/ && dur_str !~ /m/) {
					sub(/s$/, "", dur_str);
					sec = dur_str + 0;
				} else if (dur_str ~ /m/) {
					min = dur_str; sub(/m.*$/, "", min);
					s_part = dur_str; sub(/^.*m/, "", s_part); sub(/s$/, "", s_part);

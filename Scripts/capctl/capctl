#!/bin/sh
# /usr/bin/capctl - Automated Full Packet & Sing-Box Real-Time Log Capture Manager
# Features:
#  1. BPF Filtering: Exclude SSH (port 22) and local DNS hijack (port 5333) by default
#  2. Dual Modes: Lightweight Header-Only (-s 128) vs Full Payload (-s 0 via 'start-cap full')
#  3. Environment Snapshot: Generates env_snapshot.txt with routing, node, and DNS states
#  4. Real-time Triage Summary: 'analyze-cap' extracts TCP RST, DNS queries, and Sing-Box errors
#  5. Ring-Buffer Quota: Retains newest 10 slices (FIFO) + 3-day auto-purge + 50% disk safeguard
#  6. Qualcomm NSS ECM Awareness: 'start-cap nonss' pauses HW fastpath; auto-restores on stop
#  7. Log Level Auto Restore: Backs up original level and restores upon stop with zero side effects
#  8. DHCP Device Attribution: Resolves LAN IPs to device hostnames from /tmp/dhcp.leases
#  9. TCP Loss & Retransmission Analysis: Calculates retrans rate and isolates congested endpoints
# 10. Built-in User Guide: Comprehensive help manual accessible via 'capctl help' or '--help'

CHUNK_SIZE_MB="${CHUNK_SIZE_MB:-100}"
MAX_SLICES="${MAX_SLICES:-10}"
STATE_DIR="/var/run/capctl"
PID_FILE="$STATE_DIR/tcpdump.pid"
SB_PID_FILE="$STATE_DIR/singbox.pid"
WATCHDOG_PID_FILE="$STATE_DIR/watchdog.pid"
ALERT_FILE="/etc/capctl_disk_alert"
PERSIST_LEVEL_FILE="/etc/capctl_orig_homeproxy_level"
PERSIST_NSS_FILE="/etc/capctl_nss_paused"
CRED_FILE="/etc/capctl/capctl.env"
[ ! -f "$CRED_FILE" ] && [ -f "$HOME/.capctl.env" ] && CRED_FILE="$HOME/.capctl.env"

load_credentials() {
	if [ -f "$CRED_FILE" ]; then
		local line
		while IFS= read -r line || [ -n "$line" ]; do
			case "$line" in
				\#*|"") continue ;;
				GEMINI_API_KEY=*)
					if [ -z "$GEMINI_API_KEY" ]; then
						local raw_k="${line#GEMINI_API_KEY=}"
						raw_k="${raw_k#\"}"; raw_k="${raw_k%\"}"; raw_k="${raw_k#\'}"; raw_k="${raw_k%\'}"
						export GEMINI_API_KEY="$raw_k"
					fi
					;;
				GITHUB_TOKEN=*)
					if [ -z "$GITHUB_TOKEN" ]; then
						local raw_t="${line#GITHUB_TOKEN=}"
						raw_t="${raw_t#\"}"; raw_t="${raw_t%\"}"; raw_t="${raw_t#\'}"; raw_t="${raw_t%\'}"
						export GITHUB_TOKEN="$raw_t"
					fi
					;;
				GEMINI_MODEL=*)
					if [ -z "$GEMINI_MODEL" ]; then
						local raw_m="${line#GEMINI_MODEL=}"
						raw_m="${raw_m#\"}"; raw_m="${raw_m%\"}"; raw_m="${raw_m#\'}"; raw_m="${raw_m%\'}"
						export GEMINI_MODEL="$raw_m"
					fi
					;;
			esac
		done < "$CRED_FILE"
	fi
	[ -z "$GEMINI_MODEL" ] && export GEMINI_MODEL="gemini-3.5-flash-lite"
}

save_credentials() {
	local g_key="$1"
	local gh_tok="$2"
	local g_mod="${3:-gemini-3.5-flash-lite}"

	g_key="${g_key#\"}"; g_key="${g_key%\"}"; g_key="${g_key#\'}"; g_key="${g_key%\'}"
	gh_tok="${gh_tok#\"}"; gh_tok="${gh_tok%\"}"; gh_tok="${gh_tok#\'}"; gh_tok="${gh_tok%\'}"
	g_mod="${g_mod#\"}"; g_mod="${g_mod%\"}"; g_mod="${g_mod#\'}"; g_mod="${g_mod%\'}"

	local target_conf="/etc/capctl/capctl.env"
	if [ ! -d "/etc/capctl" ]; then
		mkdir -p "/etc/capctl" 2>/dev/null || target_conf="$HOME/.capctl.env"
	fi
	chmod 700 "$(dirname "$target_conf")" 2>/dev/null

	{
		echo "# CapCtl 本地私有安全凭据配置 (严格权限 600，绝不同步公网与代码仓库)"
		echo "GEMINI_API_KEY=\"$g_key\""
		echo "GITHUB_TOKEN=\"$gh_tok\""
		echo "GEMINI_MODEL=\"$g_mod\""
	} > "$target_conf"
	chmod 600 "$target_conf"

	export GEMINI_API_KEY="$g_key"
	export GITHUB_TOKEN="$gh_tok"
	export GEMINI_MODEL="$g_mod"
	CRED_FILE="$target_conf"
}

rotate_ai_log() {
	local f="$1"
	if [ -f "$f" ]; then
		local sz="$(wc -c < "$f" 2>/dev/null || echo 0)"
		if [ "$sz" -gt 5242880 ]; then
			mv -f "$f" "${f}.old" 2>/dev/null || true
		fi
	fi
}

show_ai_log() {
	local target_mnt="$(get_largest_mount)"
	local log_file="$target_mnt/pcap_vault/ai_audit.log"
	[ ! -f "$log_file" ] && log_file="/var/log/capctl_ai.log"

	if [ ! -f "$log_file" ] || [ ! -s "$log_file" ]; then
		echo "ℹ️  暂无 AI 研判日志记录。运行 capctl ai 或 capctl ai-sync 后将自动生成。"
		return 0
	fi

	echo "============================================================"
	echo "       📜 CapCtl AI 智能审计追踪日志 ($log_file)             "
	echo "============================================================"
	if [ "$1" = "-f" ] || [ "$1" = "follow" ]; then
		tail -n 60 -f "$log_file"
	else
		tail -n 60 "$log_file"
		echo "------------------------------------------------------------"
		echo "💡 提示: 实时追踪日志可运行: capctl ai log -f"
		echo "============================================================"
	fi
}


			local sniff_domains="$(grep -E 'sniffed protocol: .*, domain:' $log_files 2>/dev/null | \
				awk -F'domain: ' '{print $2}' | sort | uniq -c | sort -nr | head -n 5)"
			if [ -n "$sniff_domains" ]; then

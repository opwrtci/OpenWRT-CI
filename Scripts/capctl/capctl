				match($0, /\[([0-9]+)[[:space:]]/, arr); id = arr[1];
				match($0, /to ([^[:space:]]+)/, arr_dst); dst = arr_dst[1];
				dom = conn_dom[id]; src = conn_src[id];
				if (src == "") src = "局域网终端";
				if (dom ~ /(\.cn$|taobao|tmall|alipay|alicdn|alibaba|aliyun|tencent|qq\.com|weixin|wechat|qpic|gtimg|gdtimg|cmpassport|10086|10010|189\.cn|jd\.com|360buy|pinduoduo|pddpic|douyin|bytedance|snssdk|bilibili|hdslb|xiaohongshu|xhscdn|kuaishou|meituan|dianping|xiaomi|mi\.com|heytap|oppo|vivo|huawei|honor|unionpay|cmbchina|icbc|12306|tanx\.com|mmstat\.com|gepush\.com|igexin\.com|talkingdata\.com|aliapp\.org|effirst\.com|id6\.me|easytomessage\.com|anythinktech\.com|appier)/) {
					leaked_dom[dom " [终端: " src "]"]++;
				}
				if (dst ~ /^(155\.102\.|163\.181\.|139\.95\.|47\.88\.|47\.89\.|47\.90\.|47\.91\.|47\.246\.|198\.11\.|205\.204\.|43\.109\.)/) {
					leaked_anycast[dst " [终端: " src "]"]++;
				}
			}
			END {
				for (d in leaked_dom) print "DOM\t" d "\t" leaked_dom[d];
				for (a in leaked_anycast) print "ANY\t" a "\t" leaked_anycast[a];

			;;
		*) echo "已退出配置。" ;;
	esac
}

format_duration() {
	local seconds="$1"
	[ -z "$seconds" ] && seconds=0
	local days=$((seconds / 86400))
	local hours=$(( (seconds % 86400) / 3600 ))
	local mins=$(( (seconds % 3600) / 60 ))
	local secs=$((seconds % 60))

	local res=""
	if [ "$days" -gt 0 ]; then
		res="${days}天 ${hours}小时 ${mins}分 ${secs}秒"
	elif [ "$hours" -gt 0 ]; then
		res="${hours}小时 ${mins}分 ${secs}秒"
	elif [ "$mins" -gt 0 ]; then
		res="${mins}分 ${secs}秒"
	else
		res="${secs}秒"
	fi
	echo "$res"
}

get_largest_mount() {
	local mnt
	mnt="$(df -k | awk 'NR>1 && $6 !~ /^\/tmp|^\/dev|^\/rom/ && $4 ~ /^[0-9]+$/ {print $4, $6}' | sort -nr | head -n1 | awk '{print $2}')"
	[ -n "$mnt" ] && [ -d "$mnt" ] || mnt="/overlay"
	echo "$mnt"
}

cleanup_old_records() {
	local base_dir="$1"
	local max_slices="${MAX_SLICES:-10}"
	[ -d "$base_dir" ] || return 0

	# 1. Purge older than 3 days
	find "$base_dir" -type f \( -name "*.pcap" -o -name "*.log" \) -mtime +3 -delete 2>/dev/null
	find "$base_dir" -type f -name ".recording*" -mtime +3 -delete 2>/dev/null

	# 2. Ring-buffer FIFO quota (keep newest $max_slices .pcap files)
	local pcap_count="$(find "$base_dir" -type f -name 'cap_*.pcap' 2>/dev/null | wc -l)"
	if [ "$pcap_count" -gt "$max_slices" ]; then
		local to_del=$((pcap_count - max_slices))
		find "$base_dir" -type f -name 'cap_*.pcap' 2>/dev/null | sort | head -n "$to_del" | while read -r f; do
			rm -f "$f"
		done
	fi

	# Keep newest $max_slices singbox .log files
	local log_count="$(find "$base_dir" -type f -name 'singbox_*.log' 2>/dev/null | wc -l)"
	if [ "$log_count" -gt "$max_slices" ]; then
		local to_del=$((log_count - max_slices))
		find "$base_dir" -type f -name 'singbox_*.log' 2>/dev/null | sort | head -n "$to_del" | while read -r f; do
			rm -f "$f"
		done
	fi

	# 3. Clean empty directories
	find "$base_dir" -depth -mindepth 1 -type d -empty -delete 2>/dev/null
}

is_running() {
	if [ -f "$PID_FILE" ]; then
		local pid="$(cat "$PID_FILE" 2>/dev/null)"
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
	fi
	if [ -f "$SB_PID_FILE" ]; then
		local sb_pid="$(cat "$SB_PID_FILE" 2>/dev/null)"
		[ -n "$sb_pid" ] && kill -0 "$sb_pid" 2>/dev/null && return 0
	fi
	return 1
}

setup_singbox_log_level() {
	if uci -q get homeproxy.config >/dev/null; then
		local cur_level="$(uci -q get homeproxy.config.log_level)"
		[ -z "$cur_level" ] && cur_level="warn"
		echo "$cur_level" > "$STATE_DIR/orig_homeproxy_log_level"
		echo "$cur_level" > "$PERSIST_LEVEL_FILE"

		if [ "$cur_level" != "debug" ] && [ "$cur_level" != "trace" ]; then
			uci set homeproxy.config.log_level='debug'
			uci commit homeproxy
			/etc/init.d/homeproxy reload >/dev/null 2>&1
			sleep 1
			echo "🔍 已自动将 Sing-Box 日志级别提升至: debug (原级别: $cur_level，停止抓包后将自动还原)"
		else
			echo "🔍 Sing-Box 日志级别当前已为: $cur_level (保持现行级别)"
		fi
	fi
}

restore_singbox_log_level() {
	local orig_level=""
	if [ -f "$STATE_DIR/orig_homeproxy_log_level" ]; then
		orig_level="$(cat "$STATE_DIR/orig_homeproxy_log_level" 2>/dev/null)"
	elif [ -f "$PERSIST_LEVEL_FILE" ]; then
		orig_level="$(cat "$PERSIST_LEVEL_FILE" 2>/dev/null)"
	fi

	if [ -n "$orig_level" ] && uci -q get homeproxy.config >/dev/null; then
		local cur_level="$(uci -q get homeproxy.config.log_level)"
		if [ "$cur_level" != "$orig_level" ]; then
			uci set homeproxy.config.log_level="$orig_level"
			uci commit homeproxy
			/etc/init.d/homeproxy reload >/dev/null 2>&1
			echo "🔄 Sing-Box 日志级别已自动还原为: $orig_level (无任何残留影响)"
		fi
	fi
	rm -f "$STATE_DIR/orig_homeproxy_log_level" "$PERSIST_LEVEL_FILE" 2>/dev/null
}

setup_nss_acceleration() {
	local pause_nss="$1"
	if [ "$pause_nss" -eq 1 ] && [ -d /sys/kernel/debug/ecm ]; then
		echo 1 > /sys/kernel/debug/ecm/front_end_ipv4_stop 2>/dev/null
		echo 1 > /sys/kernel/debug/ecm/front_end_ipv6_stop 2>/dev/null
		echo 1 > "$STATE_DIR/nss_paused"
		echo 1 > "$PERSIST_NSS_FILE"
		echo "⚡ 已临时旁路高通 NSS ECM 硬件加速 (确保抓包捕获 100% 底层穿透报文)"
	elif [ -d /sys/kernel/debug/ecm ]; then
		local conn_count="$(cat /sys/kernel/debug/ecm/ecm_db/connection_count 2>/dev/null || echo "0")"
		echo "⚡ 高通 NSS 硬件加速: 运行中 (当前加速流: $conn_count，如需排查硬件旁路丢包可使用: capctl start nonss)"
	fi
}

restore_nss_acceleration() {
	if [ -f "$STATE_DIR/nss_paused" ] || [ -f "$PERSIST_NSS_FILE" ]; then
		if [ -d /sys/kernel/debug/ecm ]; then
			echo 0 > /sys/kernel/debug/ecm/front_end_ipv4_stop 2>/dev/null
			echo 0 > /sys/kernel/debug/ecm/front_end_ipv6_stop 2>/dev/null
			echo "⚡ 已自动恢复高通 NSS ECM 硬件加速 (零性能损耗)"
		fi
		rm -f "$STATE_DIR/nss_paused" "$PERSIST_NSS_FILE" 2>/dev/null
	fi
}

generate_snapshot() {
	local dest_dir="$1"
	local snap_file="$dest_dir/env_snapshot.txt"

	{
		echo "============================================================"
		echo "          🌐 网络环境瞬态快照 (Network Environment Snapshot)"
		echo "============================================================"
		echo "⏰ 记录时间 : $(date '+%Y-%m-%d %H:%M:%S')"
		echo "⏱️  运行时间 : $(uptime | sed 's/^[ \t]*//')"
		echo "------------------------------------------------------------"
		echo "[1. IP 地址与网络接口 (Interfaces)]"
		ip -brief addr 2>/dev/null || ip addr show
		echo ""
		echo "[2. 核心路由表 (Routing Tables)]"
		ip route show 2>/dev/null
		echo ""
		echo "[3. 策略路由规则 (IP Rules)]"
		ip rule show 2>/dev/null
		echo ""
		echo "[4. DNS 解析配置 (Resolvers)]"
		cat /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null || cat /etc/resolv.conf 2>/dev/null
		echo ""
		if uci -q get homeproxy.config >/dev/null; then
			echo "[5. HomeProxy / Sing-Box 核心配置]"
			local node_id="$(uci -q get homeproxy.config.main_node)"
			local node_desc="$(uci -q get homeproxy.$node_id.label 2>/dev/null || uci -q get homeproxy.$node_id.server 2>/dev/null || echo "$node_id")"
			echo "  - 当前活动主节点 : $node_desc ($node_id)"
			echo "  - 路由分流模式   : $(uci -q get homeproxy.config.routing_mode)"
			echo "  - 代理端口模式   : $(uci -q get homeproxy.config.routing_port)"
			echo "  - 远端主 DNS     : $(uci -q get homeproxy.config.dns_server)"
			echo "  - 国内直连 DNS   : $(uci -q get homeproxy.config.china_dns_server)"
			echo "  - 日志级别配置   : $(uci -q get homeproxy.config.log_level)"
			echo ""
		fi
		echo "[6. 高通 NSS 硬件加速 (ECM Status)]"
		if [ -d /sys/kernel/debug/ecm ]; then
			local ecm_conn="$(cat /sys/kernel/debug/ecm/ecm_db/connection_count 2>/dev/null || echo "N/A")"
			local v4_stop="$(cat /sys/kernel/debug/ecm/front_end_ipv4_stop 2>/dev/null || echo "0")"
			echo "  - 当前硬件加速连接数: $ecm_conn"
			echo "  - 前端加速状态 (v4): $([ "$v4_stop" = "1" ] && echo "已暂停(Bypassed)" || echo "运行中(Accelerated)")"
		else
			echo "  - NSS ECM: 未启用或不支持 debugfs"
		fi
		echo ""
		echo "[7. 局域网活跃客户端 (DHCP Leases)]"
		if [ -f /tmp/dhcp.leases ]; then
			awk '{print "  - " $3 " : " $4 " (MAC: " $2 ")"}' /tmp/dhcp.leases
		else
			echo "  (无 DHCP 租约记录)"
		fi
		echo ""
		echo "[8. 内存与负载 (System Resources)]"
		free -m 2>/dev/null
		echo "============================================================"
	} > "$snap_file"
}

do_analyze_wifi() {
	echo "📶【7. Wi-Fi 无线链路与射频健康体检】"
	if ! command -v iw >/dev/null 2>&1 && ! command -v iwinfo >/dev/null 2>&1; then
		echo "  (未检测到 iw 或 iwinfo 工具，跳过无线体检)"
		return 0
	fi

	local ifaces="$(iw dev 2>/dev/null | grep Interface | awk '{print $2}')"
	if [ -z "$ifaces" ]; then
		echo "  (未发现活跃的无线网络接口)"
		return 0
	fi

	local total_stas=0
	local band_stas=""

	for iface in $ifaces; do
		local info="$(iwinfo $iface info 2>/dev/null)"
		local ssid="$(echo "$info" | grep "ESSID:" | awk -F\" '{print $2}')"
		local chan="$(echo "$info" | grep "Channel:" | sed -E 's/.*Channel:[[:space:]]*//; s/[[:space:]]*HT Mode:.*//')"
		local txp="$(echo "$info" | grep "Tx-Power:" | awk '{print $2, $3}')"
		[ -z "$ssid" ] && ssid="$iface"

		local survey_stat="$(iw dev $iface survey dump 2>/dev/null | awk '
			/\[in use\]/ { in_use = 1; }
			in_use && /noise:/ { noise = $2; }
			in_use && /channel active time:/ { act = $4; }
			in_use && /channel busy time:/ { busy = $4; in_use = 0; }
			END {
				if (act > 0) printf("空口占用: %.1f%% | 底噪: %s dBm", (busy * 100.0 / act), noise);
			}')"

		local stations="$(iw dev $iface station dump 2>/dev/null)"
		local sta_cnt="$(echo "$stations" | grep -c "^Station " 2>/dev/null)"
		[ -z "$sta_cnt" ] && sta_cnt=0
		total_stas=$((total_stas + sta_cnt))
		band_stas="$band_stas $iface:$sta_cnt"

		echo "  📡 射频接口: $iface (SSID: \"$ssid\" | 信道: ${chan:-未知} | 功率: ${txp:-未知}${survey_stat:+ | $survey_stat})"
		if [ "$sta_cnt" -eq 0 ]; then
			echo "     (当前无连接终端)"
			continue
		fi

		echo "$stations" | awk -v iface="$iface" '
		BEGIN {
			while ((getline < "/tmp/dhcp.leases") > 0) {
				if ($2 != "" && $4 != "*" && $4 != "") hosts[tolower($2)] = $4 " (" $3 ")";
			}
		}
		/^Station / {
			if (mac != "") print_sta();
			mac = tolower($2);
			signal = 0; tx_rate = ""; rx_rate = ""; tx_failed = 0; tx_retries = 0; tx_pkts = 0; exp_thru = "";
			inact_ms = 0; conn_sec = 0;
		}
		/inactive time:/ { inact_ms = $3 + 0; }
		/connected time:/ { conn_sec = $3 + 0; }
		/signal:/ && !/signal avg:/ { signal = $2 + 0; }
		/tx bitrate:/ {
			sub(/^[ \t]*tx bitrate:[ \t]*/, "");
			tx_rate = $0;
		}
		/rx bitrate:/ {
			sub(/^[ \t]*rx bitrate:[ \t]*/, "");
			rx_rate = $0;
		}
		/tx failed:/ { tx_failed = $3 + 0; }
		/tx retries:/ { tx_retries = $3 + 0; }
		/tx packets:/ { tx_pkts = $3 + 0; }
		/expected throughput:/ { exp_thru = $3; }
		function print_sta() {
			name = (mac in hosts) ? hosts[mac] : mac;
			sig_icon = "🟢 极佳";
			if (signal < -65) sig_icon = "🟡 良好";
			if (signal < -72) sig_icon = "🟠 稍弱";
			if (signal < -78) sig_icon = "🔴 极弱";

			inact_str = "";
			if (inact_ms > 30000) {
				inact_str = sprintf(" [💤 终端已休眠 %d秒]", int(inact_ms / 1000));
			}

			printf("     📱 终端: %s%s\n", name, inact_str);
			printf("        - 物理信号: %d dBm [%s]\n", signal, sig_icon);
			printf("        - 协商速率: 下行(TX): %s | 上行(RX): %s\n", (tx_rate ? tx_rate : "未知"), (rx_rate ? rx_rate : "未知"));
			if (exp_thru != "") printf("        - 预期吞吐: %s\n", exp_thru);
			if (tx_failed > 0 || tx_retries > 0) {
				fps = (conn_sec > 0) ? (tx_failed / conn_sec) : 0;
				printf("        - 空口丢帧: 发送失败 %d 帧 | 重试 %d 帧 (连线时长: %d秒 | 平均失败频次: %.2f 帧/秒)\n", tx_failed, tx_retries, conn_sec, fps);
				if (inact_ms > 30000 && fps < 10) {
					printf("        💡 [省电机制说明] 终端正处于深度休眠 (WMM-PS/DTIM)，背景广播未能即时响应，非业务丢包。\n");
				}
			}

			if (signal <= -72) {
				printf("        ⚠️ [弱信号风险] 物理衰减较大，易发生空口竞争丢失与重传降速。\n");
			}
			if (tx_rate ~ /^[0-9.]+[ \t]*MBit\/s$/ && rx_rate ~ /HE-MCS/) {
				if (inact_ms > 30000) {
					printf("        ℹ️ [空闲速率休眠] 终端当前无活跃数据流，Wi-Fi 速率自适应降频保活 (有流量时秒级恢复 Wi-Fi 6 高阶调制)。\n");
				} else {
					printf("        ⚠️ [调制降级风险] 终端下行已退化为传统低阶调制 (非 Wi-Fi 6 HE)，建议调整终端距离或频段。\n");
				}
			}
		}
		END {
			if (mac != "") print_sta();
		}
		'
	done

	echo "  📊【射频负载均衡审计】: 在网终端总数: $total_stas 台"
	local crowded_iface=""
	local idle_5g=""
	for b in $band_stas; do
		local b_if="$(echo "$b" | cut -d: -f1)"
		local b_cnt="$(echo "$b" | cut -d: -f2)"
		if [ "$b_cnt" -ge 8 ]; then
			crowded_iface="$b_if ($b_cnt台)"
		fi
		if [ "$b_cnt" -eq 0 ] && echo "$b_if" | grep -qE "phy0|phy2"; then
			[ -z "$idle_5g" ] && idle_5g="$b_if" || idle_5g="$idle_5g $b_if"
		fi
	done
	if [ -n "$crowded_iface" ] && [ -n "$idle_5g" ]; then
		echo "     ⚠️ [多频密集告警] 检测到单频接入设备较多: $crowded_iface，而另一 5GHz 硬件频段 $idle_5g 完全空闲。"
		echo "        💡 建议: 可将部分高带宽吞吐终端分流至 $idle_5g，获取最极致的空口隔离带宽。"
	elif [ "$total_stas" -le 4 ]; then
		echo "     ✅ 射频负载极轻 (当前仅 $total_stas 台设备，AX6600 硬件吞吐绰绰有余，无需干预)。"
		if [ -n "$idle_5g" ]; then
			echo "        💡 提示: 路由器具备双 5GHz 独立芯片硬件，如未来有 NAS/PC 大文件下载，可单独连入另一 5G 频段实现物理隔离。"
		fi
	else
		echo "     ✅ 射频频段分配处于均衡状态。"
	fi

	local ath_errs="$(dmesg 2>/dev/null | grep -iE "ath11k.*(crash|error|failed|fault|beacon miss)" | tail -n 3)"
	if [ -n "$ath_errs" ]; then
		echo "  ⚠️ [驱动日志告警] 检测到底层无线驱动异常事件:"
		echo "$ath_errs" | sed "s/^/     /"
	else
		echo "  ✅ 底层无线驱动与固件稳定运行无报错。"
	fi
}

do_audit() {
	local arg1="$1"
	local target_dir=""
	if [ -n "$arg1" ] && [ -d "$arg1" ]; then
		target_dir="$arg1"
	else
		local target_mnt="$(get_largest_mount)"
		local base_dir="$target_mnt/pcap_vault"
		target_dir="$base_dir/captures_$(date +%Y-%m-%d)"
		if [ ! -d "$target_dir" ]; then
			target_dir="$(find "$base_dir" -mindepth 1 -maxdepth 1 -type d -name "captures_*" 2>/dev/null | sort | tail -n 1)"
		fi
	fi

	if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
		echo "❌ 未找到抓包取证目录，请先运行 capctl start 开始抓包。"
		return 1
	fi

	local log_files="$(find "$target_dir" -type f \( -name "singbox_*.log" -o -name ".recording_singbox.log" \) 2>/dev/null | sort)"
	if [ -z "$log_files" ]; then
		echo "❌ 目录下未发现 Sing-Box 决策流日志，无法进行分流审计。"
		return 1
	fi

	echo "============================================================"
	echo "   🎯 CapCtl 分流漏网与规则库缺失专项审计报告 (Rule Audit)   "
	echo "============================================================"
	echo "📁 审计日志 : $target_dir"
	echo "⏰ 审计时间 : $(date '+%Y-%m-%d %H:%M:%S')"
	echo "------------------------------------------------------------"

	awk '
	BEGIN {
		while ((getline < "/tmp/dhcp.leases") > 0) {
			if ($3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $4 != "*" && $4 != "") hosts[$3] = $4;
		}
	}
	function format_dev(ip) {
		if (ip in hosts) return ip " (" hosts[ip] ")";
		return ip;
	}
	/inbound\/tun.*inbound redirect connection from/ {
		match($0, /\[([0-9]+)[[:space:]]/, arr); id = arr[1];
		for(i=1;i<=NF;i++) if ($i == "from") { src = $(i+1); sub(/:[0-9]+$/, "", src); conn_src[id] = format_dev(src); }
	}
	/router: (sniffed protocol: .*, domain:|found reserve mapped domain:)/ {
		match($0, /\[([0-9]+)[[:space:]]/, arr); id = arr[1];
		match($0, /domain: ([^[:space:]]+)/, arr_dom);
		if (arr_dom[1] != "" && !(id in conn_dom)) conn_dom[id] = arr_dom[1];
	}
	/outbound\/[^d].*: outbound connection to/ {
		match($0, /\[([0-9]+)[[:space:]]/, arr); id = arr[1];
		match($0, /to ([^[:space:]]+)/, arr_dst); dst = arr_dst[1];
		dom = conn_dom[id]; src = conn_src[id];
		if (src == "") src = "局域网终端";
		if (dom ~ /(\.cn$|taobao|tmall|alipay|alicdn|alibaba|aliyun|tencent|qq\.com|weixin|wechat|qpic|gtimg|gdtimg|cmpassport|10086|10010|189\.cn|jd\.com|360buy|pinduoduo|pddpic|douyin|bytedance|snssdk|bilibili|hdslb|xiaohongshu|xhscdn|kuaishou|meituan|dianping|xiaomi|mi\.com|heytap|oppo|vivo|huawei|honor|unionpay|cmbchina|icbc|12306|tanx\.com|mmstat\.com|gepush\.com|igexin\.com|talkingdata\.com|aliapp\.org|effirst\.com|id6\.me|easytomessage\.com|anythinktech\.com|appier)/) {
			leaked_dom[dom " [触发终端: " src "]"]++;
			suggest_dom[dom] = 1;
		}
		if (dst ~ /^(155\.102\.|163\.181\.|139\.95\.|47\.88\.|47\.89\.|47\.90\.|47\.91\.|47\.246\.|198\.11\.|205\.204\.|43\.109\.)/) {
			leaked_anycast[dst " [触发终端: " src "]"]++;
			suggest_ip[dst] = 1;
		}
	}
	/dns: exchanged/ && $6 ~ /ms\]/ && $10 ~ /NOERROR|NXDOMAIN/ {
		ms = $6; gsub(/[^0-9]/, "", ms); ms = ms + 0;
		dom = $9;
		if (ms >= 150 && dom ~ /(\.cn$|\.lan$|cmpassport|gdtimg|tanx|mmstat|snssdk)/) {
			if (!(dom in slow_dns_map) || ms > slow_dns_map[dom]) slow_dns_map[dom] = ms;
		}
	}
	END {
		print "【1. 疑似国内高频域名走海外代理漏网 (Domestic Domains Leaked)】"
		has_dom = 0;
		for (d in leaked_dom) {
			print "  ⚠️ 漏网域名: " d " (错误走代理频次: " leaked_dom[d] ")";
			has_dom = 1;
		}
		if (!has_dom) print "  ✅ 未发现任何已知境内域名被错误代理出站 (所有境内已知域名均已成功直连)";
		
		print "\n【2. 阿里/国内 Anycast 调度段漏网 (Domestic Anycast Leaked)】"
		has_any = 0;
		for (a in leaked_anycast) {
			print "  ⚠️ 异常出站 IP: " a " (错误走代理频次: " leaked_anycast[a] ")";
			has_any = 1;
		}
		if (!has_any) print "  ✅ 阿里/AMDC 国内 Anycast 段当前 100% 成功直连 (0 次异常出站)";

		print "\n【3. 域名越洋慢解析漏网 (DNS Resolves via Proxy >= 150ms)】"
		has_slow = 0;
		for (s in slow_dns_map) {
			print "  ⏱️ 慢解析域名: " s " (耗时: " slow_dns_map[s] "ms)";
			has_slow = 1;
		}
		if (!has_slow) print "  ✅ 未发现境内域名越洋慢解析异常";

		print "\n【4. 智能自愈与规则建议 (Actionable Recommendations)】"
		if (has_dom || has_any) {
			print "  💡 检测到分流未收录条目，推荐处理方式:"
			if (has_dom) {
				print "     • 可直接在 OpenWrt Web 界面【HomeProxy 客户端配置】->【分流控制】->【直连域名列表 (Direct List)】中添加以下漏网域名:"
				for (sd in suggest_dom) print "         + " sd;
			}
			if (has_any) {
				print "     • 漏网 IP 段建议补入 meta-rules-dat custom-rules 或 wan_direct_ipv4_ips 列表中。";
			}
		} else {
			print "  🎉 当前分流规则覆盖完美，未检测到任何境内业务泄漏至海外代理！";
		}
	}
	' $log_files
	echo "============================================================"
}

do_extract() {
	local arg1="$1"
	local arg2="$2"
	local target_dir=""
	local is_silent=0

	if [ "$arg1" = "silent" ]; then
		is_silent=1
		target_dir=""
	elif [ "$arg2" = "silent" ]; then
		is_silent=1
		target_dir="$arg1"
	else
		target_dir="$arg1"
	fi

	if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
		local target_mnt="$(get_largest_mount)"
		local base_dir="$target_mnt/pcap_vault"
		target_dir="$base_dir/captures_$(date +%Y-%m-%d)"
		if [ ! -d "$target_dir" ]; then
			target_dir="$(find "$base_dir" -mindepth 1 -maxdepth 1 -type d -name "captures_*" 2>/dev/null | sort | tail -n 1)"
		fi
	fi

	if [ -z "$target_dir" ] || [ ! -d "$target_dir" ]; then
		[ $is_silent -eq 0 ] && echo "❌ 未找到抓包取证目录，请先运行 capctl start 开始抓包。"
		return 1
	fi

	local log_files="$(find "$target_dir" -type f \( -name "singbox_*.log" -o -name ".recording_singbox.log" \) 2>/dev/null | sort)"
	if [ -z "$log_files" ]; then
		[ $is_silent -eq 0 ] && echo "❌ 目录下未发现 Sing-Box 决策流日志，无法进行数据包规则提取。"
		return 1
	fi

	local now_ts="$(date +%Y%m%d_%H%M%S)"
	local out_txt="$target_dir/candidate_rules_${now_ts}.txt"
	local out_json="$target_dir/candidate_rules_${now_ts}.json"
	if [ $is_silent -eq 1 ]; then
		out_txt="$target_dir/candidate_rules_latest.txt"
		out_json="$target_dir/candidate_rules_latest.json"
	fi

	if [ $is_silent -eq 0 ]; then
		echo "============================================================"
		echo "   ⛏️  CapCtl 智能规则数据提取与候选挖掘 (Rule Extract)      "
		echo "============================================================"
		echo "📁 数据目录 : $target_dir"
		echo "⏰ 提取时间 : $(date '+%Y-%m-%d %H:%M:%S')"
		echo "🛡️  安全隔离 : 仅分析提取候选数据 | [🔒 不写本地路由] [🔒 不推远程仓库]"
		echo "------------------------------------------------------------"
	fi

	awk -v out_txt="$out_txt" -v out_json="$out_json" -v now_ts="$now_ts" -v is_silent="$is_silent" '
	BEGIN {
		# 1. 加载 DHCP 设备映射
		while ((getline < "/tmp/dhcp.leases") > 0) {
			if ($3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $4 != "*" && $4 != "") hosts[$3] = $4;
		}
		# 2. 加载本地已直连域名 (避免重复提取)
		direct_file = "/etc/homeproxy/diversion/direct.txt";
		while ((getline < direct_file) > 0) {
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0);
			if ($0 != "" && $0 !~ /^#/) existing_direct[$0] = 1;
		}
		# 3. 基础内置已知大厂主域名 (若已正常直连则不作多余提取)
		standard_builtin = "^(taobao\\.com|alipay\\.com|alicdn\\.com|alipayobjects\\.com|qq\\.com|tencent\\.com|baidu\\.com|bilibili\\.com|douyin\\.com|jd\\.com|163\\.com|sina\\.com|weibo\\.com|xiaomi\\.com|mi\\.com|oppomobile\\.com|vivo\\.com|huawei\\.com|honor\\.com|youku\\.com|amap\\.com|ele\\.me|elemecdn\\.com|alibabachengdun\\.com|alibabacorp\\.com|aliyuncs\\.com|aliyun-inc\\.com|pinduoduo\\.com|pinduoduo\\.net)$";
		# 4. GFW 投毒虚假 IP 库 (严禁将解析到投毒 IP 的境外网站误当国内业务)
		poison_ips = "^(221\\.228\\.32\\.13|118\\.184\\.78\\.78|203\\.208\\.46\\.200|31\\.13\\.72\\.36|243\\.185\\.187\\.39|37\\.61\\.54\\.158|46\\.82\\.174\\.68|78\\.16\\.49\\.15|93\\.46\\.8\\.89)$";
	}
	function format_dev(ip) {
		if (ip in hosts) return ip " (" hosts[ip] ")";
		return ip;
	}
	function get_root_domain(dom) {
		sub(/^\.+/, "", dom); sub(/\.+$/, "", dom);
		n = split(dom, parts, ".");
		if (n <= 1) return dom;
		if (n == 2) return dom;
		tld = parts[n]; s_tld = parts[n-1];
		if ((s_tld == "com" || s_tld == "net" || s_tld == "org" || s_tld == "gov" || s_tld == "edu") && (tld == "cn" || tld == "hk" || tld == "tw" || tld == "uk")) {
			if (n >= 3) return parts[n-2] "." s_tld "." tld;
			return dom;
		}
		return parts[n-1] "." tld;
	}

	# 记录连接触发来源设备
	/inbound\/tun.*inbound (redirect|packet) connection from/ {
		id = $5; gsub(/[^0-9]/, "", id);
		for(i=1;i<=NF;i++) if ($i == "from") { src = $(i+1); sub(/:[0-9]+$/, "", src); conn_src[id] = format_dev(src); }
	}
	# 记录嗅探域名
	/router: (sniffed .*domain:|found reserve mapped domain:)/ {
		id = $5; gsub(/[^0-9]/, "", id);
		dom = $0; sub(/.*domain:[[:space:]]*/, "", dom); sub(/[[:space:],].*/, "", dom);
		if (dom != "" && !(id in conn_dom)) conn_dom[id] = dom;
	}

	# 记录已由 geosite-cn 或 direct-out 规则正确分流的域名 (排除无效候选)
	/rule_set=geosite-cn/ || /route\(china-dns\)/ || /route\(direct-out\)/ || /=> bypass\(\)/ {
		id = $5; gsub(/[^0-9]/, "", id);
		dom = conn_dom[id];
		if (dom != "") {
			root = get_root_domain(dom);
			already_covered[dom] = 1;
			already_covered[root] = 1;
		}
		if (id in dns_queries) {
			qdom = dns_queries[id];
			root = get_root_domain(qdom);
			already_covered[qdom] = 1;
			already_covered[root] = 1;
		}
	}

	# 记录走海外代理出站的连接 (用于与国内特征进行交叉印证)
	/outbound\/[^d].*: outbound (packet )?connection to/ {
		id = $5; gsub(/[^0-9]/, "", id);
		dst = $0; sub(/.* to /, "", dst); sub(/[[:space:]].*/, "", dst); sub(/:[0-9]+$/, "", dst);
		dom = conn_dom[id];
		if (dom != "") {
			root = get_root_domain(dom);
			if (root !~ /(\.arpa$|\.lan$|localhost$)/) {
				leaked_to_proxy[root] = 1;
				if (candidate_subdomains[root] !~ dom) {
					candidate_subdomains[root] = (candidate_subdomains[root] == "" ? "" : candidate_subdomains[root] ", ") dom;
				}
			}
		}
		if (dst ~ /^(155\.102\.|163\.181\.|139\.95\.|47\.88\.|47\.89\.|47\.90\.|47\.91\.|47\.246\.|198\.11\.|205\.204\.|43\.109\.)/) {
			anycast_hits[dst]++;
		}
	}

	# 识别国内主流云厂商与 CDN CNAME 铁证
	/dns: exchanged CNAME/ {
		q_dom = $0; sub(/.*exchanged CNAME[[:space:]]+/, "", q_dom); sub(/[[:space:]].*/, "", q_dom); sub(/\.+$/, "", q_dom);
		t_dom = $0; sub(/.*IN CNAME[[:space:]]+/, "", t_dom); sub(/[[:space:]].*/, "", t_dom); sub(/\.+$/, "", t_dom);
		if (t_dom ~ /(\.w\.alikunlun\.com|alibabadns\.com|alipaydns\.com|alicdn\.com|tbcache\.com|\.dnsv1\.com|\.kunlun.*\.com|queniuak\.com|huaweicloud\.com|chinacache\.net|qiniucdn\.com|baidupcs\.com|ourwebcdn\.com|txcloudcdn\.com|tencent-cloud\.net|bytedance\.net|bytedns[0-9]*\.com|cdnbuild\.net|volces\.com|volccdn\.com)/) {
			cname_dom[q_dom] = "CNAME 递归命中国内主流云厂商/CDN 节点 (" t_dom ")";
			root = get_root_domain(q_dom);
			if (root !~ /(\.arpa$|\.lan$|localhost$)/ && root !~ /(google|facebook|twitter|telegram|apple|openai|github|cloudflare|fastly|akamai|akadns|gvt1|doubleclick|crashlytics|googlesyndication|app-measurement|gstatic|ntp\.org|voip|stun)/) {
				if (root !~ /\.cn$/ && !(root in existing_direct) && !(root in already_covered)) {
					if (root !~ standard_builtin || (root in leaked_to_proxy)) {
						candidate_hits[root]++;
						if (root in leaked_to_proxy) {
							candidate_reason[root] = "🚨 铁证：确认命中国内云厂商 CNAME (" t_dom ") 但实际连接错误泄漏走海外代理出站 (漏网)";
						} else if (!(root in candidate_reason)) {
							candidate_reason[root] = cname_dom[q_dom];
						}
						if (candidate_subdomains[root] !~ q_dom) {
							candidate_subdomains[root] = (candidate_subdomains[root] == "" ? "" : candidate_subdomains[root] ", ") q_dom;
						}
					}
				}
			}
		}
	}

	# 收集所有 DNS 解析事件并研判
	/dns: exchange/ {
		id = $5; gsub(/[^0-9]/, "", id);
		dom = $0; sub(/.*dns: exchange[[:space:]]+(A |AAAA |CNAME )?/, "", dom); sub(/[[:space:]].*/, "", dom); sub(/\.+$/, "", dom);
		if (dom == "" || dom !~ /\./ || dom ~ /(\.arpa$|\.lan$|localhost$)/) next;
		dns_queries[id] = dom;
		# 排除海外已知 GMS / GFW 封锁服务与全球公共 CDN
		if (dom ~ /(google|facebook|twitter|telegram|apple|openai|github|cloudflare|fastly|akamai|akadns|gvt1|doubleclick|crashlytics|googlesyndication|app-measurement|gstatic|ntp\.org|voip|stun)/) next;

		root = get_root_domain(dom);
		if (root == "" || root ~ /\.cn$/) next; # 纯 .cn 默认已被全局直连规则收录
		if (root in existing_direct || root in already_covered) next; # 已经加入直连列表或已被 geosite-cn 覆盖
		if (root ~ standard_builtin && !(root in leaked_to_proxy)) next; # 已被基础内置规则库覆盖且未走代理

		reason = "";
		if (dom in cname_dom) {
			reason = cname_dom[dom];
		} else if (dom ~ /(aliapp|effirst|id6\.me|easytomessage|anythinktech|appier|snssdk|ctobsnssdk|cmpassport|gdtimg|tanx|mmstat|talkingdata|gepush|igexin|10086|10010|189|pinduoduo|unionpay|12306|ccb|icbc|cmb|95598|sgcc|volcengine)/) {
			reason = "命中国内运营商认证 / 核心大厂第三方 SDK 签名特征";
		}

		if (reason != "") {
			candidate_hits[root]++;
			if (root in leaked_to_proxy) {
				candidate_reason[root] = "🚨 铁证：确认命中国内特征但实际连接错误泄漏走海外代理出站 (漏网)";
			} else if (!(root in candidate_reason)) {
				candidate_reason[root] = reason;
			}
			if (candidate_subdomains[root] !~ dom) {
				candidate_subdomains[root] = (candidate_subdomains[root] == "" ? "" : candidate_subdomains[root] ", ") dom;
			}
		}
	}

	END {
		has_candidates = 0;
		header_txt = "============================================================\n" \
		             "   📋 候选待入库规则数据集 (Candidate Rules Dataset)        \n" \
		             "   提取批次: " now_ts "\n" \
		             "   模式声明: [🔒 纯审计提取模式] 本地配置未变更 / 远程未推送\n" \
		             "============================================================\n";
		print header_txt > out_txt;

		json_dom_list = "";
		if (!is_silent) print "【1. 挖掘出的国内待入库候选域名 (Candidate Domestic Domains)】";
		print "\n【1. 挖掘出的国内待入库候选域名 (Candidate Domestic Domains)】" >> out_txt;
		for (r in candidate_hits) {
			has_candidates = 1;
			line = sprintf("  ✨ 候选根域名 : %s (出现 %d 次)\n     • 判定依据 : %s\n     • 关联子域名 : %s", r, candidate_hits[r], candidate_reason[r], candidate_subdomains[r]);
			if (!is_silent) print line;
			print line >> out_txt;
			
			entry_json = sprintf("{\"domain\":\"%s\",\"hits\":%d,\"reason\":\"%s\",\"samples\":\"%s\"}", r, candidate_hits[r], candidate_reason[r], candidate_subdomains[r]);
			json_dom_list = (json_dom_list == "" ? "" : json_dom_list ",") entry_json;
		}
		if (!has_candidates) {
			msg = "  ✅ 当前未发现任何未收录的国内域名（现有规则库或直连列表已完全覆盖）。";
			if (!is_silent) print msg;
			print msg >> out_txt;
		}

		if (!is_silent) print "\n【2. 挖掘出的国内 Anycast 待入库 IP (Candidate Anycast CIDRs)】";
		print "\n【2. 挖掘出的国内 Anycast 待入库 IP (Candidate Anycast CIDRs)】" >> out_txt;
		has_anycast = 0;
		json_any_list = "";
		for (a in anycast_hits) {
			has_anycast = 1;
			line = sprintf("  🌐 候选 Anycast IP : %s (触发频次: %d 次) -> 建议段: %s.0/24", a, anycast_hits[a], a);
			if (!is_silent) print line;
			print line >> out_txt;
			entry_json = sprintf("{\"ip\":\"%s\",\"hits\":%d}", a, anycast_hits[a]);
			json_any_list = (json_any_list == "" ? "" : json_any_list ",") entry_json;
		}
		if (!has_anycast) {
			msg = "  ✅ 当前未发现任何未收录的国内 Anycast 异常出站 IP。";
			if (!is_silent) print msg;
			print msg >> out_txt;
		}

		if (!is_silent) print "\n【3. 安全隔离与数据存盘报告 (Safety Status)】";
		status_msg = sprintf("  🔒 本地路由热写入 : [已跳过 / 保持原样]\n" \
		                     "  🔒 远程 Git 自动提交 : [已跳过 / 隔离未推送]\n" \
		                     "  💾 结构化分析文本已保存至 : %s\n" \
		                     "  💾 自动化待审 JSON 已保存至 : %s", out_txt, out_json);
		if (!is_silent) print status_msg;
		print "\n【3. 安全隔离与数据存盘报告】\n" status_msg >> out_txt;

		printf "{\"timestamp\":\"%s\",\"status\":\"isolated_extracted\",\"candidates\":[%s],\"anycast\":[%s]}\n", now_ts, json_dom_list, json_any_list > out_json;
	}
	' $log_files

	if [ $is_silent -eq 0 ]; then
		cp -f "$out_txt" "$target_dir/candidate_rules_latest.txt" 2>/dev/null
		cp -f "$out_json" "$target_dir/candidate_rules_latest.json" 2>/dev/null
		echo "============================================================"
	fi
	# 自动累积合并入长效持久化候选观察池 (支持跨天长期静默收集)
	update_candidate_pool "$out_json"
	return 0
}

update_candidate_pool() {
	local latest_json="$1"
	[ -f "$latest_json" ] || return 0

	local target_mnt="$(get_largest_mount)"
	local base_dir="$target_mnt/pcap_vault"
	local pool_file="$base_dir/candidate_pool.json"
	local today="$(date +%Y-%m-%d)"

	local pool_arg="$pool_file"
	[ ! -f "$pool_arg" ] && pool_arg="/dev/null"

	awk -v today="$today" '
	BEGIN {
		RS = "}";
	}
	FILENAME == ARGV[1] {
		if (match($0, /"domain"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); d = s;
			h = 1;
			if (match($0, /"hits"[[:space:]]*:[[:space:]]*[0-9]+/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*/, "", s); h = s + 0;
			}
			f_seen = today;
			if (match($0, /"first_seen"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); f_seen = s;
			}
			l_seen = today;
			if (match($0, /"last_seen"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); l_seen = s;
			}
			rs = "";
			if (match($0, /"reason"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); rs = s;
			}
			sm = "";
			if (match($0, /"samples"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); sm = s;
			}
			if (d != "") {
				pool[d] = 1; hits[d] = h; first_seen[d] = f_seen; last_seen[d] = l_seen; reason[d] = rs; samples[d] = sm;
			}
		}
	}
	FILENAME == ARGV[2] {
		if (match($0, /"domain"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
			s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); d = s;
			h = 1;
			if (match($0, /"hits"[[:space:]]*:[[:space:]]*[0-9]+/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*/, "", s); h = s + 0;
			}
			rs = "";
			if (match($0, /"reason"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); rs = s;
			}
			sm = "";
			if (match($0, /"samples"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
				s = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*"/, "", s); sub(/"$/, "", s); sm = s;
			}
			if (d != "") {
				if (d in pool) {
					hits[d] += h;
					last_seen[d] = today;
					if (rs != "" && reason[d] !~ rs) reason[d] = reason[d] "; " rs;
					if (sm != "" && samples[d] !~ sm) samples[d] = samples[d] ", " sm;
				} else {
					pool[d] = 1; hits[d] = h; first_seen[d] = today; last_seen[d] = today; reason[d] = rs; samples[d] = sm;
				}
			}
		}
	}
	END {
		first = 1;
		printf "{\"updated_at\":\"%s\",\"pool\":[", today;
		for (d in pool) {
			if (!first) printf ",";
			first = 0;
			printf "{\"domain\":\"%s\",\"hits\":%d,\"first_seen\":\"%s\",\"last_seen\":\"%s\",\"reason\":\"%s\",\"samples\":\"%s\"}", \
				d, hits[d], first_seen[d], last_seen[d], reason[d], samples[d];
		}
		printf "]}\n";
	}
	' "$pool_arg" "$latest_json" > "${pool_file}.tmp" 2>/dev/null

	if [ -s "${pool_file}.tmp" ]; then
		mv -f "${pool_file}.tmp" "$pool_file"
	else
		rm -f "${pool_file}.tmp"
	fi
}


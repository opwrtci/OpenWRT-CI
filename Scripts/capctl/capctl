do_ai_toggle() {
	local target="$1"
	if ! is_running; then
		echo "⚠️  当前抓包看门狗未运行。请先运行 capctl start 启动抓包。"
		return 1
	fi
	if [ "$target" = "0" ] || [ "$target" = "off" ] || [ "$target" = "disable" ] || [ "$target" = "stop" ]; then
		if [ ! -f "$STATE_DIR/ai_autopilot" ]; then
			echo "ℹ️  当前 AI 深度研判与自动提交功能本就处于【关闭】状态，无需更改。"
			return 0
		fi
		rm -f "$STATE_DIR/ai_autopilot"
		echo "============================================================"
		echo "     🛑 已关闭 AI 深度研判与自动提交 (AI Autopilot Paused)  "
		echo "============================================================"
		echo "⚙️  抓包看门狗状态 : 🟢 持续运行中 (数据报文与决策日志正常录制)"
		echo "🤖 AI 自动闭环   : ⚪ 已暂停 (不会再向云端发起研判或自动提库)"
		echo "💡 如需再次激活   : 随时输入 capctl ai on"
		echo "============================================================"
	else
		if [ -f "$STATE_DIR/ai_autopilot" ]; then
			echo "ℹ️  当前 AI 深度研判与自动提交功能已处于【开启】状态中。"
			return 0
		fi
		if ! ensure_gemini_key; then
			echo "⚠️  未能配置有效 Gemini 凭据，无法激活 AI 功能。"
			return 1
		fi
		touch "$STATE_DIR/ai_autopilot"
		echo "============================================================"
		echo "     🚀 已激活 AI 深度研判与自动提交 (AI Autopilot Active)  "
		echo "============================================================"
		echo "⚙️  抓包看门狗状态 : 🟢 持续运行中"
		echo "🤖 AI 自动闭环   : 🟢 已开启 (进入 48 小时周期沉淀与国内规则自动提库)"
		echo "💡 如需随时关闭   : 随时输入 capctl ai off"
		echo "============================================================"
	fi
}

show_help() {
	cat << 'EOF_HELP'
================================================================================
  📡 CapCtl - OpenWrt 全量抓包与 Sing-Box 实时决策流排障取证系统
================================================================================

【定位与使用】
  CapCtl 是专为 OpenWrt (软路由/硬路由) 设计的一体化网络诊断与分流排障系统。
  所有网络抓包、分流审计、Wi-Fi 体检与链路排障功能已全部整合进单一工具中！

  快捷交互: 直接输入 capctl (或超短别名 cap) 回车，进入全中文交互式菜单。
  命令行模式: capctl <子命令> [参数]

--------------------------------------------------------------------------------
【子命令速查】
--------------------------------------------------------------------------------
  • capctl start [full] [nonss] [BPF]  : 开启抓包 (默认轻量防爆模式)
  • capctl restart [full] [nonss]      : 平滑重启抓包 (归档当前切片并无缝开跑)
  • capctl stop                       : 停止抓包并恢复加速与日志级别

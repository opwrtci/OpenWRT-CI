				echo "$doh_errs" | awk '{print "    - " $0}'
			fi
			local nx_domains="$(grep -E 'NXDOMAIN|SERVFAIL' $log_files 2>/dev/null | \
				awk '($10 ~ /NXDOMAIN|SERVFAIL/) {print $9 " (" $10 ")"}' | sort | uniq -c | sort -nr | head -n 5)"
			if [ -n "$nx_domains" ]; then
				echo "  ⚠️ 检测到域名解析失败 (NXDOMAIN):"
				echo "$nx_domains" | awk '{print "    - " $2 " : " $1 " 次失败"}'
			else
				echo "  ✅ 未检测到 NXDOMAIN 解析异常"
			fi

			local slow_dns="$(awk '
				/dns: exchanged/ && $6 ~ /ms\]/ && $10 ~ /NOERROR|NXDOMAIN/ {
					ms = $6; gsub(/[^0-9]/, "", ms); ms = ms + 0;
					dom = $9;
					if (ms >= 150) {
						if (!(dom in max_ms) || ms > max_ms[dom]) {
							max_ms[dom] = ms;
							status[dom] = $10;
						}
					}
				}
				END {
					for (d in max_ms) print max_ms[d] "ms\t" d " (" status[d] ")";
				}' $log_files 2>/dev/null | sort -k1,1nr | head -n 5)"
			if [ -n "$slow_dns" ]; then
				echo "  ⏱️ 耗时较高 DNS 请求 (>= 150ms):"
				echo "$slow_dns" | awk '{print "    - 耗时 " $1 " : " $2}'
				echo "  💡 提示: 针对慢解析的国内/运营商认证域名，可在 HomeProxy 客户端分流控制中加入“直连域名列表”秒级提速。"
			fi
		fi

		echo ""
		# 3. 网络底层异常 (TCP RST / 重传 / 异常断开)
		echo "⚡【4. TCP 异常连接与 RST 复位检测】"
		if [ -n "$latest_pcap" ] && [ -f "$latest_pcap" ]; then
			local rst_targets=""
			rst_targets="$(tcpdump -nn -r "$latest_pcap" 'tcp[tcpflags] & tcp-rst != 0 and not port 22' 2>/dev/null | \
				awk '
				BEGIN {
					while ((getline < "/tmp/dhcp.leases") > 0) {
						if ($3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $4 != "*" && $4 != "") hosts[$3] = $4;
					}
				}
				function format_ep(ep) {
					sub(/:$/, "", ep);
					match(ep, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/);
					if (RSTART > 0) {
						ip = substr(ep, RSTART, RLENGTH);
						rest = substr(ep, RSTART + RLENGTH);
						if (ip in hosts) return ip rest " (" hosts[ip] ")";
					}
					return ep;
				}
				function get_port(ep) {
					n = split(ep, parts, ".");
					return parts[n];
				}
				function get_ip(ep) {
					sub(/:$/, "", ep);
					sub(/\.[0-9]+$/, "", ep);
					return ep;
				}
				{
					for(i=1;i<=NF;i++) {
						if($i ~ />/) {
							raw_src = $(i-1);
							raw_dst = $(i+1);
							sub(/:$/, "", raw_dst);
							seq = "";
							for(j=i+1; j<=NF; j++) {
								if($j == "seq") { seq = $(j+1); sub(/,$/, "", seq); break; }
							}
							
							src_port = get_port(raw_src);
							dst_ip = get_ip(raw_dst);
							dst_port = get_port(raw_dst);
							
							# Cross-interface and cross-NAT deduplication
							dedup_key = dst_ip "_" src_port "_" dst_port "_" seq;
							if (seen_pkt[dedup_key]++) next;
							
							# Associate WAN NAT IP back to LAN device if known
							if (raw_src ~ /^192\.168\.31\./ && src_port in lan_src_map) {
								raw_src = lan_src_map[src_port];
							} else if (raw_src ~ /^192\.168\.(1|10)\./) {
								lan_src_map[src_port] = raw_src;
							}
							
							src_fmt = format_ep(raw_src);
							dst_fmt = format_ep(raw_dst);
							
							# Classify client-side socket teardown vs server rejection
							if (raw_dst ~ /\.(443|80|8080|8443)$/) {
								type = "[📱 终端主动断开/会话销毁]";
							} else {
								type = "[🌐 服务端拒绝/异常复位]";
							}

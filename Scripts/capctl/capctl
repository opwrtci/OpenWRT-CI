	echo "   9) 候选规则挖掘提取 (extract)    - 挖掘待同步域名数据 (不写路由不推远程)"
	echo "  10) 🤖 AI 智能深度研判 (ai)      - Gemini 3.5 Flash Lite 深度研判 (>=2天沉淀)"
	echo "  11) ⚡ AI 研判并自动入库 (ai-sync) - 深度研判高置信度域名并自动热生效与云端同步"
	echo "  12) 📜 查看 AI 研判追踪日志 (ai log) - 复盘大模型推理过程与归因决策依据"
	echo "  13) Wi-Fi 射频体检 (wifi)        - 终端信号 RSSI、协商速率与空口质量"
	echo "  14) 极速健康巡检 (check)        - Sing-Box、Dnsmasq 与核心服务极速巡检"
	echo "  15) 查看详细状态 (status)       - 查看当前抓包切片与运行时长"
	echo "  16) 清理历史释放空间 (clean)     - 清理旧的 PCAP 报文与日志归档"
	echo "  17) 一键直连入库与联动 (add-direct) - 快速将漏网国内域名生效并提交"
	echo "  18) 🔐 配置 AI 与云端密钥 (config) - 安全管理本地私有 Gemini 密钥与 GitHub Token"
	echo "   0) 退出"
	echo "============================================================"
	printf " 请输入选项编号 [0-18]: "
	read -r choice
	echo ""
	case "$choice" in
		1) do_start ;;
		2)
			if is_running; then
				if [ -f "$STATE_DIR/ai_autopilot" ]; then
					do_ai_toggle 0
				else
					do_ai_toggle 1
				fi
			else
				do_start ai
			fi
			;;
		3) do_start full ;;
		4) do_start nonss ;;
		5) do_restart ;;
		6) do_stop ;;
		7)
			printf " 可选: 请输入要靶向追踪的域名或 IP (直接回车进行全量分析): "
			read -r kw
			do_analyze $kw
			;;
		8) do_audit ;;
		9) do_extract ;;
		10) do_ai_audit ;;
		11) do_ai_sync ;;
		12) show_ai_log ;;
		13) do_analyze_wifi ;;
		14) do_doctor ;;
		15) do_status ;;
		16) do_cleanup ;;
		17)
			printf " 请输入要直连的国内域名 (例如 ctobsnssdk.com): "
			read -r dom
			do_add_direct "$dom"
			;;
		18) do_config ;;
		0|"") echo "已退出。"; exit 0 ;;
		*) echo "❌ 无效选项: $choice"; exit 1 ;;
	esac
}

INVOKED_CMD="$(basename "$0")"
case "$INVOKED_CMD" in
	stop-cap)              ACTION="stop" ;;
	start-cap)             ACTION="start" ;;
	restart-cap)           ACTION="restart" ;;
	status-cap)            ACTION="status" ;;
	analyze-cap)           ACTION="analyze" ;;
	audit-cap)             ACTION="audit" ;;
	extract-cap|mine-cap)  ACTION="extract" ;;
	ai-cap)                ACTION="ai" ;;
	ailog-cap)             ACTION="ai-log" ;;
	aisync-cap)            ACTION="ai-sync" ;;
	config-cap)            ACTION="config" ;;
	check-cap|doctor-cap)  ACTION="doctor" ;;
	*)
		if [ $# -eq 0 ]; then
			if [ -t 0 ]; then
				do_menu
				exit 0
			else
				ACTION="status"
			fi
		else
			ACTION="$1"
			shift
		fi
		;;
esac

case "$ACTION" in
	start)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_start "$@" ;;
		esac
		;;
	restart)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_restart "$@" ;;
		esac
		;;
	stop)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_stop "$@" ;;
		esac
		;;
	status)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_status "$@" ;;
		esac
		;;
	analyze|triage)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_analyze "$@" ;;
		esac
		;;
	audit)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_audit "$@" ;;
		esac
		;;
	extract|mine)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_extract "$@" ;;
		esac
		;;
	ai|ai-audit)
		case "$1" in
			-h|--help|help) show_help ;;
			off|disable|stop|no|0) do_ai_toggle 0 ;;
			on|enable|start|yes|1) do_ai_toggle 1 ;;
			log|logs) shift; show_ai_log "$@" ;;
			*) do_ai_audit "$@" ;;
		esac
		;;
	ai-log|ailog) show_ai_log "$@" ;;
	ai-off|noai) do_ai_toggle 0 ;;
	ai-on|aion) do_ai_toggle 1 ;;
	ai-sync)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_ai_sync "$@" ;;
		esac
		;;
	ai-cron)
		do_ai_cron "$@"
		;;
	add-direct|add-rule|sync-rule)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_add_direct "$@" ;;
		esac
		;;
	config|cred)
		case "$1" in
			-h|--help|help) show_help ;;
			*) do_config "$@" ;;
		esac
		;;
	doctor|check) do_doctor "$@" ;;
	wifi) do_analyze_wifi "$@" ;;
	cleanup|clean) do_cleanup "$@" ;;
	menu) do_menu ;;
	-h|--help|help) show_help ;;
	*)
		echo "❌ 未知子命令: $ACTION"
		echo "💡 输入 capctl help 查看完整命令帮助，或直接输入 capctl 进入交互菜单。"
		exit 1
		;;
esac

